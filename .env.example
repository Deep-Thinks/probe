# Probe 环境变量示例。本地复制为 .env 或 source 之后启动。
# 生产环境通过 Zeabur 控制台注入。

# --- 数据库 / 备份 ---
PROBE_DB_PATH=./data/db.sqlite3
PROBE_BACKUP_DIR=./data/backups
PROBE_BACKUP_RETAIN_DAYS=30
PROBE_WECHAT_RETAIN_DAYS=30

# --- HTTP server ---
PORT=8080

# --- 作者后台 HTTP Basic Auth ---
PROBE_ADMIN_USER=admin
PROBE_ADMIN_PASS=change-me-in-prod

# --- 金币哈希盐 ---
# 把微信号转成可跨 30 天隐私清理存活的耐久身份（用于金币余额聚合）。
# 一旦设定不可更改，否则历史金币哈希全部对不上。生产务必设一个随机值。
PROBE_COIN_SECRET=

# --- LLM Fallback 链 ---
# 主：stepfun step-3.6（用户已有内测权限）
STEPFUN_BASE_URL=https://api.stepfun.com/v1/chat/completions
STEPFUN_API_KEY=
STEPFUN_MODEL=step-3.6

# 备用 1：DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 备用 2：Qwen（DashScope OpenAI 兼容端点）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# --- 本地烟测：跳过真实 LLM 调用 ---
# 设为 1 时 ai_worker 使用 mock 响应，便于本地端到端 dogfood。
PROBE_LLM_MOCK=0
